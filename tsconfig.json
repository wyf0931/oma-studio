{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "noUncheckedIndexedAccess": true
  },
  "vueCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    "frontend/src/**/*.ts",
    "frontend/src/**/*.vue"
  ]
}
